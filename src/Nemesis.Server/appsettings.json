{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "Nemesis": {
    "Llm": {
      "Provider": "ollama",
      "OllamaBaseUrl": "http://localhost:11434",
      "ModelName": "deepseek-coder-v2:16b",
      "EmbeddingModel": "nomic-embed-text",
      "Temperature": 0.7,
      "MaxTokens": 4096,
      "ContextWindow": 16384,
      "UseOpenAiFallback": false
    },
    "WebSearch": {
      "Enabled": true,
      "SearchEngine": "duckduckgo",
      "MaxResults": 10,
      "CacheExpirationHours": 24,
      "CachePath": "./cache/web",
      "AllowedDomains": [
        "docs.unity3d.com",
        "forum.unity.com",
        "github.com",
        "stackoverflow.com",
        "learn.microsoft.com"
      ]
    },
    "Project": {
      "ExcludedFolders": [
        "Library",
        "Temp",
        "obj",
        "bin",
        "Logs",
        ".git",
        ".vs",
        "Builds",
        "Build",
        "UserSettings"
      ],
      "ExcludedExtensions": [
        ".meta",
        ".asset",
        ".prefab",
        ".unity",
        ".mat",
        ".shader"
      ],
      "BackupPath": "./backups",
      "AutoBackup": true,
      "MaxBackupAge": 7
    },
    "Ui": {
      "AutoApplyPatches": false,
      "ShowDetailedLogs": true,
      "Theme": "dark",
      "MaxChatHistory": 100
    },
    "Storage": {
      "DatabasePath": "./data/nemesis.db",
      "VectorStorePath": "./data/vectors.db",
      "CachePath": "./cache",
      "BackupPath": "./backups"
    }
  }
}
