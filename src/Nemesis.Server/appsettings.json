{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      }
    }
  },
  "Nemesis": {
    "Llm": {
      "Provider": "ollama",
      "OllamaBaseUrl": "http://localhost:11434",
      "ModelName": "codestral:22b",
      "EmbeddingModel": "nomic-embed-text",
      "Temperature": 0.7,
      "MaxTokens": 8192,
      "ContextWindow": 32768,
      "UseOpenAiFallback": false
    },
    "WebSearch": {
      "Enabled": true,
      "SearchEngine": "duckduckgo",
      "MaxResults": 10,
      "CacheExpirationHours": 24,
      "CachePath": "./cache/web",
      "AllowedDomains": [
        "docs.unity3d.com",
        "forum.unity.com",
        "github.com",
        "stackoverflow.com",
        "learn.microsoft.com",
        "youtube.com",
        "google.com",
        "reddit.com",
        "medium.com",
        "dev.to",
        "hashnode.com",
        "codeproject.com",
        "codepen.io",
        "jsfiddle.net",
        "dotnetfiddle.net",
        "replit.com",
        "gist.github.com",
        "gitlab.com",
        "bitbucket.org",
        "unity.com",
        "unityassetstore.com",
        "gamedev.net",
        "gamedeveloper.com",
        "indiedb.com",
        "itch.io",
        "wikipedia.org",
        "w3schools.com",
        "tutorialspoint.com",
        "geeksforgeeks.org",
        "freecodecamp.org",
        "codecademy.com",
        "pluralsight.com",
        "udemy.com",
        "coursera.org",
        "edx.org",
        "docs.microsoft.com",
        "devblogs.microsoft.com",
        "techcommunity.microsoft.com",
        "dotnet.microsoft.com",
        "nuget.org",
        "npmjs.com",
        "pypi.org",
        "rubygems.org",
        "docs.python.org",
        "developer.mozilla.org",
        "css-tricks.com",
        "smashingmagazine.com",
        "alistapart.com",
        "codinghorror.com",
        "martinfowler.com",
        "refactoring.guru",
        "sourcemaking.com",
        "baeldung.com",
        "javatpoint.com",
        "programiz.com",
        "realpython.com",
        "hackernoon.com",
        "towardsdatascience.com",
        "dzone.com",
        "infoq.com",
        "theserverside.com",
        "vogella.com",
        "raywenderlich.com",
        "kodeco.com",
        "androidauthority.com",
        "appcoda.com",
        "nshipster.com",
        "objc.io",
        "swift.org",
        "kotlinlang.org",
        "typescriptlang.org",
        "rust-lang.org",
        "golang.org",
        "elixir-lang.org",
        "haskell.org",
        "scala-lang.org",
        "clojure.org",
        "lua.org",
        "php.net",
        "ruby-lang.org",
        "cppreference.com",
        "cplusplus.com",
        "isocpp.org",
        "electronjs.org",
        "reactjs.org",
        "vuejs.org",
        "angular.io",
        "svelte.dev",
        "nextjs.org",
        "nuxtjs.org",
        "gatsbyjs.org",
        "astro.build",
        "tailwindcss.com",
        "getbootstrap.com",
        "mui.com",
        "chakra-ui.com"
      ]
    },
    "Project": {
      "ExcludedFolders": [
        "Library",
        "Temp",
        "obj",
        "bin",
        "Logs",
        ".git",
        ".vs",
        "Builds",
        "Build",
        "UserSettings"
      ],
      "ExcludedExtensions": [
        ".meta",
        ".asset",
        ".prefab",
        ".unity",
        ".mat",
        ".shader"
      ],
      "BackupPath": "./backups",
      "AutoBackup": true,
      "MaxBackupAge": 7
    },
    "Ui": {
      "AutoApplyPatches": false,
      "ShowDetailedLogs": true,
      "Theme": "dark",
      "MaxChatHistory": 100
    },
    "Storage": {
      "DatabasePath": "./data/nemesis.db",
      "VectorStorePath": "./data/vectors.db",
      "CachePath": "./cache",
      "BackupPath": "./backups"
    }
  }
}
