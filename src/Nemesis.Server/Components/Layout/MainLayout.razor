@inherits LayoutComponentBase

<div class="app-container">
    <header class="app-header">
        <div class="header-brand">
            <span class="logo">N</span>
            <span class="title">Nemesis</span>
            <span class="subtitle">Unity AI Assistant</span>
        </div>
        <div class="header-status">
            <span class="status-item @(llmConnected ? "connected" : "disconnected")">
                LLM: @(llmConnected ? "Connected" : "Disconnected")
            </span>
            <span class="status-item @(projectLoaded ? "connected" : "")">
                @(projectLoaded ? "Project Loaded" : "No Project")
            </span>
        </div>
    </header>

    <nav class="app-nav">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="nav-icon">&#128193;</span> Project
        </NavLink>
        <NavLink class="nav-link" href="chat">
            <span class="nav-icon">&#128172;</span> Chat
        </NavLink>
        <NavLink class="nav-link" href="tasks">
            <span class="nav-icon">&#128203;</span> Tasks
        </NavLink>
        <NavLink class="nav-link" href="patches">
            <span class="nav-icon">&#128221;</span> Patches
        </NavLink>
        <NavLink class="nav-link" href="logs">
            <span class="nav-icon">&#128196;</span> Logs
        </NavLink>
        <NavLink class="nav-link" href="settings">
            <span class="nav-icon">&#9881;</span> Settings
        </NavLink>
    </nav>

    <main class="app-main">
        @Body
    </main>

    <footer class="app-footer">
        <span>Nemesis v1.0 | Local Mode | .NET 8 + Blazor Server</span>
    </footer>
</div>

@code {
    private bool llmConnected = false;
    private bool projectLoaded = false;

    [Inject] private Nemesis.Server.Services.ProjectService ProjectService { get; set; } = default!;
    [Inject] private ILlmProvider LlmProvider { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        ProjectService.ProjectChanged += OnProjectChanged;
        projectLoaded = ProjectService.IsProjectLoaded;

        try
        {
            llmConnected = await LlmProvider.CheckHealthAsync();
        }
        catch
        {
            llmConnected = false;
        }
    }

    private void OnProjectChanged(ProjectInfo? project)
    {
        projectLoaded = project != null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ProjectService.ProjectChanged -= OnProjectChanged;
    }
}
