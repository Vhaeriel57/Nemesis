@page "/"
@using Nemesis.CodeAnalysis.Indexing
@using Nemesis.CodeAnalysis.Models
@using Nemesis.AgentCore.RAG
@using Nemesis.AgentCore.Services
@inject CodeIndexer CodeIndexer
@inject RagService RagService
@inject ProjectCacheService ProjectCacheService
@inject ProjectKnowledgeService ProjectKnowledgeService
@inject Nemesis.Server.Services.ProjectService ProjectService
@inject Nemesis.Server.Services.LogService LogService
@inject ILlmProvider LlmProvider

<PageTitle>Project - Nemesis</PageTitle>

<div class="page-container">
    <h1>Project Setup</h1>

    @if (recentProjects.Any())
    {
        <section class="section">
            <h2>Recent Projects</h2>
            <div class="recent-projects">
                @foreach (var project in recentProjects)
                {
                    <div class="recent-project-item @(project.ProjectPath == projectPath ? "selected" : "")">
                        <div class="project-info-row" @onclick="() => SelectRecentProject(project.ProjectPath)">
                            <span class="project-name">@project.ProjectName</span>
                            <span class="project-path">@project.ProjectPath</span>
                            <span class="project-accessed">Last used: @project.LastAccessedAt.ToLocalTime().ToString("g")</span>
                        </div>
                        <div class="project-actions">
                            <button class="btn btn-small btn-primary" @onclick="() => LoadFromCache(project.ProjectPath)" disabled="@isIndexing">
                                Load
                            </button>
                            <button class="btn btn-small btn-secondary" @onclick="() => ClearProjectCacheItem(project.ProjectPath)">
                                Remove
                            </button>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="section">
        <h2>Select Unity Project</h2>
        <div class="input-group">
            <input type="text" @bind="projectPath" @bind:event="oninput" placeholder="Enter Unity project path (e.g., C:\Projects\MyGame)" class="input-text" />
            <button class="btn btn-primary" @onclick="LoadFromCache" disabled="@(isIndexing || string.IsNullOrEmpty(projectPath))">
                @(isIndexing ? loadingStatus : "Load Project")
            </button>
            <button class="btn btn-secondary" @onclick="ForceReindex" disabled="@(isIndexing || string.IsNullOrEmpty(projectPath))" title="Force re-index ignoring cache">
                Re-Index
            </button>
        </div>
        <p class="help-text">Enter the root folder of your Unity project (the one containing Assets/). Cached projects load instantly!</p>

        @if (cacheStatus != null)
        {
            <div class="cache-status @(cacheStatus.IsFromCache ? "from-cache" : "fresh")">
                @if (cacheStatus.IsFromCache)
                {
                    <span class="cache-badge">Loaded from cache</span>
                    <span class="cache-info">Cached: @cacheStatus.CachedAt.ToLocalTime().ToString("g")</span>
                }
                else
                {
                    <span class="cache-badge fresh">Freshly indexed</span>
                }
            </div>
        }

        <div class="button-group" style="margin-top: 10px;">
            <button class="btn btn-secondary" @onclick="ClearIndex" disabled="@(!ProjectService.IsProjectIndexed)">
                Clear Index
            </button>
            <button class="btn btn-secondary" @onclick="ClearAllCaches" disabled="@(!recentProjects.Any())">
                Clear All Caches
            </button>
        </div>

        @if (isIndexing)
        {
            <div class="progress-container">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: @(indexProgress.PercentComplete)%"></div>
                </div>
                <div class="progress-text">
                    <span>@indexProgress.Phase</span>
                    <span>@indexProgress.Current / @indexProgress.Total</span>
                </div>
                <div class="progress-file">@indexProgress.CurrentFile</div>
            </div>
        }

        @if (ProjectService.CurrentProject != null)
        {
            <div class="project-info">
                <h3>Project Statistics</h3>
                <div class="stats-grid">
                    <div class="stat-item">
                        <span class="stat-value">@ProjectService.CurrentProject.TotalFiles</span>
                        <span class="stat-label">C# Files</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">@ProjectService.CurrentProject.TotalTypes</span>
                        <span class="stat-label">Types</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">@ProjectService.CurrentProject.TotalMethods</span>
                        <span class="stat-label">Methods</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">@ProjectService.CurrentProject.TotalLinesOfCode.ToString("N0")</span>
                        <span class="stat-label">Lines of Code</span>
                    </div>
                </div>

                @if (ProjectService.CurrentProject.Errors.Any())
                {
                    <div class="errors-section">
                        <h4>Indexing Warnings (@ProjectService.CurrentProject.Errors.Count)</h4>
                        <ul class="error-list">
                            @foreach (var error in ProjectService.CurrentProject.Errors.Take(10))
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }
            </div>
        }
    </section>

    <section class="section">
        <h2>LLM Status</h2>
        <div class="llm-status">
            <div class="status-indicator @(llmConnected ? "connected" : "disconnected")"></div>
            <span>@LlmProvider.Name: @(llmConnected ? "Connected" : "Not Connected")</span>
            <button class="btn btn-small" @onclick="CheckLlmStatus">Refresh</button>
        </div>
        @if (!llmConnected)
        {
            <div class="warning-box">
                <p>LLM is not connected. Make sure Ollama is running:</p>
                <code>ollama serve</code>
                <p>And pull the required model:</p>
                <code>ollama pull deepseek-coder-v2:16b</code>
            </div>
        }
    </section>

    <section class="section">
        <h2>Quick Actions</h2>
        <div class="quick-actions">
            <a href="chat" class="action-card @(ProjectService.IsProjectIndexed ? "" : "disabled")">
                <span class="action-icon">&#128172;</span>
                <span class="action-title">Start Chat</span>
                <span class="action-desc">Talk to AI agents about your project</span>
            </a>
            <a href="tasks" class="action-card">
                <span class="action-icon">&#128203;</span>
                <span class="action-title">View Tasks</span>
                <span class="action-desc">Manage queued tasks and plans</span>
            </a>
            <a href="patches" class="action-card">
                <span class="action-icon">&#128221;</span>
                <span class="action-title">Review Patches</span>
                <span class="action-desc">Preview and apply code changes</span>
            </a>
        </div>
    </section>
</div>

@code {
    private string projectPath = "";
    private bool isIndexing = false;
    private bool llmConnected = false;
    private string loadingStatus = "Loading...";
    private IndexingProgress indexProgress = new();
    private List<ProjectCacheEntry> recentProjects = new();
    private CacheStatusInfo? cacheStatus = null;

    private class CacheStatusInfo
    {
        public bool IsFromCache { get; set; }
        public DateTime CachedAt { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Load recent projects
        recentProjects = ProjectCacheService.GetRecentProjects();

        if (ProjectService.CurrentProject != null)
        {
            projectPath = ProjectService.CurrentProject.Path;
        }
        else
        {
            // Auto-load last used project if available
            var lastUsedPath = ProjectCacheService.GetLastUsedProjectPath();
            if (!string.IsNullOrEmpty(lastUsedPath))
            {
                projectPath = lastUsedPath;
                await LoadFromCache();
            }
        }

        await CheckLlmStatus();
    }

    private void SelectRecentProject(string path)
    {
        projectPath = path;
        StateHasChanged();
    }

    private async Task LoadFromCache()
    {
        await LoadFromCache(projectPath);
    }

    private async Task LoadFromCache(string path)
    {
        if (string.IsNullOrEmpty(path))
            return;

        projectPath = path;
        isIndexing = true;
        loadingStatus = "Checking cache...";
        indexProgress = new IndexingProgress();
        cacheStatus = null;
        StateHasChanged();

        try
        {
            var progress = new Progress<IndexingProgress>(p =>
            {
                indexProgress = p;
                loadingStatus = p.Phase;
                InvokeAsync(StateHasChanged);
            });

            // Try to load from cache first
            var (cachedIndex, cacheInfo) = await ProjectCacheService.LoadProjectIndexAsync(path);

            if (cachedIndex != null && cacheInfo != null)
            {
                // Load from cache
                loadingStatus = "Loading from cache...";
                StateHasChanged();

                CodeIndexer.LoadIndex(cachedIndex);
                ProjectService.CurrentProject = cacheInfo.ProjectInfo;

                // Charger la connaissance complète du projet
                loadingStatus = "Chargement connaissance projet...";
                StateHasChanged();
                await ProjectKnowledgeService.LoadProjectAsync(path);
                LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Info, "Knowledge",
                    $"Projet analysé: {ProjectKnowledgeService.TotalFiles} fichiers, {ProjectKnowledgeService.TotalClasses} classes");

                cacheStatus = new CacheStatusInfo
                {
                    IsFromCache = true,
                    CachedAt = cacheInfo.CachedAt
                };

                LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Info, "Cache",
                    $"Project loaded from cache: {cacheInfo.ProjectInfo.TotalFiles} files");
            }
            else
            {
                // Full indexing required
                await PerformFullIndexing(path, progress);
                cacheStatus = new CacheStatusInfo { IsFromCache = false };
            }

            // Refresh recent projects list
            recentProjects = ProjectCacheService.GetRecentProjects();
        }
        catch (Exception ex)
        {
            LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Error, "Cache", $"Load failed: {ex.Message}");
        }
        finally
        {
            isIndexing = false;
            StateHasChanged();
        }
    }

    private async Task ForceReindex()
    {
        if (string.IsNullOrEmpty(projectPath))
            return;

        isIndexing = true;
        loadingStatus = "Re-indexing...";
        indexProgress = new IndexingProgress();
        cacheStatus = null;
        StateHasChanged();

        try
        {
            var progress = new Progress<IndexingProgress>(p =>
            {
                indexProgress = p;
                loadingStatus = p.Phase;
                InvokeAsync(StateHasChanged);
            });

            // Clear existing cache first
            ProjectCacheService.ClearProjectCache(projectPath);

            await PerformFullIndexing(projectPath, progress);
            cacheStatus = new CacheStatusInfo { IsFromCache = false };

            // Refresh recent projects list
            recentProjects = ProjectCacheService.GetRecentProjects();
        }
        catch (Exception ex)
        {
            LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Error, "Indexer", $"Re-indexing failed: {ex.Message}");
        }
        finally
        {
            isIndexing = false;
            StateHasChanged();
        }
    }

    private async Task PerformFullIndexing(string path, IProgress<IndexingProgress> progress)
    {
        var projectInfo = await CodeIndexer.IndexProjectAsync(path, progress);
        ProjectService.CurrentProject = projectInfo;

        // Index for RAG
        var index = CodeIndexer.GetIndex();
        if (index is ProjectIndex projectIndex)
        {
            await RagService.IndexProjectAsync(projectIndex, progress);

            // Save to cache
            await ProjectCacheService.SaveProjectIndexAsync(projectIndex, projectInfo);
            LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Info, "Cache", "Project cached for future use");
        }

        // Charger la connaissance complète du projet pour l'agent
        loadingStatus = "Analyse complète du projet...";
        StateHasChanged();
        await ProjectKnowledgeService.LoadProjectAsync(path);
        LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Info, "Knowledge",
            $"Projet analysé: {ProjectKnowledgeService.TotalFiles} fichiers, {ProjectKnowledgeService.TotalClasses} classes");

        LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Info, "Indexer",
            $"Project indexed: {projectInfo.TotalFiles} files, {projectInfo.TotalTypes} types");
    }

    private void ClearProjectCacheItem(string path)
    {
        ProjectCacheService.ClearProjectCache(path);
        recentProjects = ProjectCacheService.GetRecentProjects();
        StateHasChanged();
    }

    private async Task ClearAllCaches()
    {
        ProjectCacheService.ClearAllCache();
        await RagService.ClearIndexAsync();
        ProjectService.CurrentProject = null;
        recentProjects = new List<ProjectCacheEntry>();
        cacheStatus = null;
        LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Info, "Cache", "All caches cleared");
        StateHasChanged();
    }

    private async Task ClearIndex()
    {
        await RagService.ClearIndexAsync();
        ProjectService.CurrentProject = null;
        cacheStatus = null;
        LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Info, "Indexer", "Index cleared");
    }

    private async Task CheckLlmStatus()
    {
        try
        {
            llmConnected = await LlmProvider.CheckHealthAsync();
        }
        catch
        {
            llmConnected = false;
        }
        StateHasChanged();
    }
}
