@page "/tasks"
@using Nemesis.AgentCore.Orchestration
@inject AgentOrchestrator Orchestrator
@inject Nemesis.Server.Services.LogService LogService

<PageTitle>Tasks - Nemesis</PageTitle>

<div class="page-container">
    <h1>Gestion des Tâches</h1>

    <section class="section">
        <h2>Créer une nouvelle tâche</h2>
        <div class="task-form">
            <div class="form-group">
                <label>Objectif</label>
                <textarea @bind="newTaskObjective" rows="3" class="input-text"
                          placeholder="Décris ce que tu veux accomplir..."></textarea>
            </div>
            <div class="form-group">
                <label>Agent</label>
                <div class="agent-badge">
                    <span class="agent-icon">🧠</span>
                    <span>Nemesis</span>
                    <span class="agent-desc">Agent unifié expert Unity/C#</span>
                </div>
            </div>
            <div class="button-group">
                <button class="btn btn-primary" @onclick="CreateTask" disabled="@string.IsNullOrWhiteSpace(newTaskObjective)">
                    Créer la tâche
                </button>
                <button class="btn btn-secondary" @onclick="CreatePlan" disabled="@string.IsNullOrWhiteSpace(newTaskObjective)">
                    Planifier d'abord
                </button>
            </div>
        </div>
    </section>

    @if (currentPlan != null)
    {
        <section class="section">
            <h2>Plan actuel</h2>
            <div class="plan-card">
                <h3>@currentPlan.Objective</h3>
                <div class="plan-steps">
                    @foreach (var step in currentPlan.Steps)
                    {
                        <div class="plan-step">
                            <span class="step-number">@step.Order</span>
                            <span class="step-description">@step.Description</span>
                            <span class="step-agent">🧠 Nemesis</span>
                            @if (step.RequiresWebSearch)
                            {
                                <span class="step-badge">🌐 Web</span>
                            }
                        </div>
                    }
                </div>
                <div class="button-group">
                    <button class="btn btn-primary" @onclick="ExecutePlan">Exécuter le plan</button>
                    <button class="btn btn-secondary" @onclick="ClearPlan">Annuler</button>
                </div>
            </div>
        </section>
    }

    <section class="section">
        <h2>File d'attente</h2>
        @if (!queuedTasks.Any() && currentTask == null)
        {
            <p class="empty-message">Aucune tâche en file d'attente.</p>
        }
        else
        {
            @if (currentTask != null)
            {
                <div class="task-card current">
                    <div class="task-header">
                        <span class="task-status in-progress">En cours</span>
                        <span class="task-agent">🧠 Nemesis</span>
                    </div>
                    <h3>@currentTask.Title</h3>
                    <p>@currentTask.Description</p>
                    @if (currentTask.Steps.Any())
                    {
                        <div class="task-progress">
                            Étape @currentTask.CurrentStep sur @currentTask.Steps.Count
                        </div>
                    }
                </div>
            }

            @foreach (var task in queuedTasks)
            {
                <div class="task-card">
                    <div class="task-header">
                        <span class="task-status @task.Status.ToString().ToLower()">@GetStatusLabel(task.Status)</span>
                        <span class="task-agent">🧠 Nemesis</span>
                    </div>
                    <h3>@task.Title</h3>
                    <p>@task.Description</p>
                </div>
            }
        }
    </section>

    <section class="section">
        <h2>Tâches terminées</h2>
        @if (!completedTasks.Any())
        {
            <p class="empty-message">Aucune tâche terminée.</p>
        }
        else
        {
            @foreach (var task in completedTasks.TakeLast(10).Reverse())
            {
                <div class="task-card completed">
                    <div class="task-header">
                        <span class="task-status @task.Status.ToString().ToLower()">@GetStatusLabel(task.Status)</span>
                        <span class="task-time">@task.CompletedAt?.ToLocalTime().ToString("g")</span>
                    </div>
                    <h3>@task.Title</h3>
                    @if (!string.IsNullOrEmpty(task.Result))
                    {
                        <details>
                            <summary>Voir le résultat</summary>
                            <pre class="task-result">@task.Result</pre>
                        </details>
                    }
                    @if (!string.IsNullOrEmpty(task.ErrorMessage))
                    {
                        <p class="task-error">Erreur: @task.ErrorMessage</p>
                    }
                </div>
            }
        }
    </section>
</div>

@code {
    private string newTaskObjective = "";
    private TaskPlan? currentPlan;
    private AgentTask? currentTask;
    private List<AgentTask> queuedTasks = new();
    private List<AgentTask> completedTasks = new();
    private bool isProcessing = false;

    protected override void OnInitialized()
    {
        currentTask = Orchestrator.GetCurrentTask();
        queuedTasks = Orchestrator.GetQueuedTasks().ToList();

        Orchestrator.TaskStarted += OnTaskStarted;
        Orchestrator.TaskCompleted += OnTaskCompleted;
        Orchestrator.TaskFailed += OnTaskFailed;
    }

    private string GetStatusLabel(AgentTaskStatus status)
    {
        return status switch
        {
            AgentTaskStatus.Pending => "En attente",
            AgentTaskStatus.InProgress => "En cours",
            AgentTaskStatus.Completed => "Terminé",
            AgentTaskStatus.Failed => "Échec",
            _ => status.ToString()
        };
    }

    private async Task CreateTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskObjective))
            return;

        var task = new AgentTask
        {
            Title = newTaskObjective.Length > 50 ? newTaskObjective.Substring(0, 50) + "..." : newTaskObjective,
            Description = newTaskObjective,
            AssignedAgent = AgentType.Manager // Uses Nemesis agent
        };

        Orchestrator.QueueTask(task);
        queuedTasks = Orchestrator.GetQueuedTasks().ToList();

        newTaskObjective = "";
        StateHasChanged();

        if (!isProcessing)
        {
            isProcessing = true;
            await Orchestrator.ProcessQueueAsync();
            isProcessing = false;
        }
    }

    private async Task CreatePlan()
    {
        if (string.IsNullOrWhiteSpace(newTaskObjective))
            return;

        try
        {
            currentPlan = await Orchestrator.CreatePlanAsync(newTaskObjective, AgentType.Manager);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Error, "Planner", $"Échec de la planification: {ex.Message}");
        }
    }

    private async Task ExecutePlan()
    {
        if (currentPlan == null)
            return;

        foreach (var step in currentPlan.Steps)
        {
            var task = new AgentTask
            {
                Title = $"Étape {step.Order}: {step.Description.Substring(0, Math.Min(40, step.Description.Length))}...",
                Description = step.Description,
                AssignedAgent = AgentType.Manager // All tasks handled by Nemesis
            };

            Orchestrator.QueueTask(task);
        }

        queuedTasks = Orchestrator.GetQueuedTasks().ToList();
        currentPlan = null;
        StateHasChanged();

        if (!isProcessing)
        {
            isProcessing = true;
            await Orchestrator.ProcessQueueAsync();
            isProcessing = false;
        }
    }

    private void ClearPlan()
    {
        currentPlan = null;
    }

    private void OnTaskStarted(AgentTask task)
    {
        currentTask = task;
        queuedTasks = Orchestrator.GetQueuedTasks().ToList();
        InvokeAsync(StateHasChanged);
    }

    private void OnTaskCompleted(AgentTask task)
    {
        completedTasks.Add(task);
        currentTask = Orchestrator.GetCurrentTask();
        queuedTasks = Orchestrator.GetQueuedTasks().ToList();
        InvokeAsync(StateHasChanged);
    }

    private void OnTaskFailed(AgentTask task)
    {
        completedTasks.Add(task);
        currentTask = Orchestrator.GetCurrentTask();
        queuedTasks = Orchestrator.GetQueuedTasks().ToList();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Orchestrator.TaskStarted -= OnTaskStarted;
        Orchestrator.TaskCompleted -= OnTaskCompleted;
        Orchestrator.TaskFailed -= OnTaskFailed;
    }
}
