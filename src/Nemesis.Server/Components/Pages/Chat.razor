@page "/chat"
@using Nemesis.AgentCore.Orchestration
@using Nemesis.AgentCore.Services
@using Nemesis.AgentCore.Tools
@inject AgentOrchestrator Orchestrator
@inject ConversationService ConversationService
@inject PatchTool PatchTool
@inject Nemesis.Server.Services.ProjectService ProjectService
@inject Nemesis.Server.Services.LogService LogService
@inject IJSRuntime JS

<PageTitle>Chat - Nemesis</PageTitle>

<div class="page-container chat-page">
    <div class="chat-sidebar">
        <div class="sidebar-header">
            <span class="nemesis-logo">🧠</span>
            <h3>Nemesis</h3>
        </div>

        <div class="new-session-btn" @onclick="NewSession">
            <span class="icon">+</span>
            <span>Nouvelle conversation</span>
        </div>

        <div class="sessions-section">
            <h4>Historique</h4>
            <div class="session-list">
                @if (!sessions.Any())
                {
                    <div class="no-sessions">Aucune conversation</div>
                }
                @foreach (var session in sessions.OrderByDescending(s => s.LastAccessedAt).Take(20))
                {
                    <div class="session-item @(session.Id == conversationId ? "active" : "")"
                         @onclick="() => LoadSession(session.Id)">
                        <div class="session-info">
                            <span class="session-name">@TruncateText(session.Name, 25)</span>
                            <span class="session-date">@FormatDate(session.LastAccessedAt)</span>
                        </div>
                        <span class="session-count">@session.MessageCount</span>
                    </div>
                }
            </div>
        </div>

        <div class="sidebar-footer">
            @if (ProjectService.IsProjectIndexed)
            {
                <div class="project-status indexed">
                    <span class="status-dot"></span>
                    <span>Projet indexé</span>
                </div>
            }
            else
            {
                <div class="project-status not-indexed">
                    <span class="status-dot"></span>
                    <a href="/">Indexer un projet</a>
                </div>
            }
        </div>
    </div>

    <div class="chat-main">
        <div class="chat-messages" @ref="messagesContainer">
            @if (!displayMessages.Any())
            {
                <div class="chat-welcome">
                    <div class="welcome-icon">🧠</div>
                    <h2>Bonjour!</h2>
                    <p>Je suis <strong>Nemesis</strong>, ton assistant expert en développement Unity.</p>
                    <div class="capabilities">
                        <div class="capability">
                            <span class="cap-icon">🎮</span>
                            <span>Unity 6 & URP</span>
                        </div>
                        <div class="capability">
                            <span class="cap-icon">💻</span>
                            <span>C# Expert</span>
                        </div>
                        <div class="capability">
                            <span class="cap-icon">🌐</span>
                            <span>Netcode</span>
                        </div>
                        <div class="capability">
                            <span class="cap-icon">🔍</span>
                            <span>Recherche Web</span>
                        </div>
                    </div>
                    @if (!ProjectService.IsProjectIndexed)
                    {
                        <p class="warning-text">
                            <span>⚠️</span> Aucun projet chargé. <a href="/">Charge un projet</a> pour que je puisse l'analyser.
                        </p>
                    }
                    else
                    {
                        <p class="ready-text">
                            <span>✅</span> Projet prêt! Pose-moi une question sur ton code.
                        </p>
                    }
                </div>
            }

            @foreach (var msg in displayMessages)
            {
                <div class="message @(msg.IsUser ? "user" : "assistant")">
                    @if (!msg.IsUser)
                    {
                        <div class="message-avatar">🧠</div>
                    }
                    <div class="message-content">
                        <div class="message-header">
                            <span class="sender">@(msg.IsUser ? "Vous" : "Nemesis")</span>
                            <span class="time">@msg.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                        </div>
                        <div class="message-body">
                            @((MarkupString)FormatMessage(msg.Content))
                        </div>
                        @if (msg.ToolNames.Any())
                        {
                            <div class="tools-used">
                                <span class="tools-label">Outils utilisés:</span>
                                @foreach (var tool in msg.ToolNames)
                                {
                                    <span class="tool-badge">@tool</span>
                                }
                            </div>
                        }
                    </div>
                    @if (msg.IsUser)
                    {
                        <div class="message-avatar user-avatar">👤</div>
                    }
                </div>
            }

            @if (isLoading)
            {
                <div class="message assistant loading">
                    <div class="message-avatar">🧠</div>
                    <div class="message-content">
                        <div class="message-header">
                            <span class="sender">Nemesis</span>
                        </div>
                        <div class="message-body">
                            @if (thinkingHistory.Any())
                            {
                                <div class="thinking-timeline">
                                    @foreach (var thought in thinkingHistory)
                                    {
                                        <div class="thinking-entry">
                                            <span class="thinking-dot"></span>
                                            <span class="thinking-text">@thought</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(streamingContent))
                            {
                                <div class="streaming-response">
                                    @((MarkupString)FormatMessage(streamingContent))
                                </div>
                            }
                            else
                            {
                                <div class="typing-indicator">
                                    <span></span><span></span><span></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="chat-input-area">
            <div class="input-container">
                <textarea @bind="inputMessage"
                          @bind:event="oninput"
                          @onkeydown="HandleKeyDown"
                          @ref="textareaRef"
                          placeholder="Écris ton message... (Entrée pour envoyer, Shift+Entrée pour nouvelle ligne)"
                          class="chat-input"
                          disabled="@isLoading"
                          rows="1"></textarea>
                <button class="send-btn"
                        @onclick="SendMessage"
                        disabled="@(isLoading || string.IsNullOrWhiteSpace(inputMessage))">
                    <span>➤</span>
                </button>
            </div>
            <div class="input-hint">
                Nemesis peut lire ton projet, générer du code et créer des patches.
            </div>
        </div>
    </div>
</div>

@code {
    private List<DisplayMessage> displayMessages = new();
    private List<ConversationSession> sessions = new();
    private string inputMessage = "";
    private string conversationId = "";
    private bool isLoading = false;
    private string streamingContent = "";
    private string currentStatus = "";
    private ElementReference messagesContainer;
    private ElementReference textareaRef;
    private AgentConversation? currentConversation;
    private List<string> currentToolCalls = new();

    private class DisplayMessage
    {
        public string Content { get; set; } = "";
        public DateTime Timestamp { get; set; } = DateTime.UtcNow;
        public bool IsUser { get; set; }
        public List<string> ToolNames { get; set; } = new();
    }

    private List<string> thinkingHistory = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshSessions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initTextareaAutoResize", textareaRef);
        }
    }

    private void CreateNewConversation()
    {
        currentConversation = ConversationService.CreateConversation(
            "Nouvelle conversation",
            ProjectService.CurrentProject?.Path ?? "");
        conversationId = currentConversation.Id;
    }

    private Task RefreshSessions()
    {
        sessions = ConversationService.GetAllSessions();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task LoadSession(string sessionId)
    {
        conversationId = sessionId;
        currentConversation = ConversationService.GetConversation(sessionId);

        if (currentConversation != null)
        {
            displayMessages = currentConversation.Messages.Select(m => new DisplayMessage
            {
                Content = m.Content,
                Timestamp = m.Timestamp,
                IsUser = m.Sender.Type == SenderType.User,
                ToolNames = m.ToolCalls?.Select(t => t.Name).ToList() ?? new()
            }).ToList();
        }
        StateHasChanged();
        await ScrollToBottom();
    }

    private async Task NewSession()
    {
        // Save current conversation if it has messages
        if (currentConversation != null && currentConversation.Messages.Any())
        {
            await ConversationService.SaveConversation(currentConversation);
        }

        // Reset to empty state (conversation created lazily on first message)
        currentConversation = null;
        conversationId = "";
        displayMessages.Clear();
        streamingContent = "";
        currentStatus = "";
        currentToolCalls.Clear();

        await RefreshSessions();
        StateHasChanged();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(inputMessage) || isLoading)
            return;

        var userMessage = inputMessage.Trim();
        inputMessage = "";
        isLoading = true;
        streamingContent = "";
        currentStatus = "";
        currentToolCalls.Clear();
        thinkingHistory.Clear();

        // Create conversation lazily on first message
        if (currentConversation == null)
        {
            CreateNewConversation();
        }

        // Add user message to display
        displayMessages.Add(new DisplayMessage
        {
            Content = userMessage,
            IsUser = true,
            Timestamp = DateTime.UtcNow
        });

        // Update conversation title if first message
        if (currentConversation != null && currentConversation.Messages.Count == 0)
        {
            currentConversation.Title = userMessage.Length > 50
                ? userMessage.Substring(0, 50) + "..."
                : userMessage;
        }

        // Add message to ConversationService
        ConversationService.AddMessage(conversationId, new AgentMessage
        {
            Content = userMessage,
            Sender = new MessageSender { Type = SenderType.User },
            Timestamp = DateTime.UtcNow
        });

        StateHasChanged();
        await ScrollToBottom();

        try
        {
            // Use Manager type which is mapped to NemesisAgent
            await foreach (var evt in Orchestrator.StreamMessageAsync(userMessage, AgentType.Manager, conversationId))
            {
                switch (evt.Type)
                {
                    case AgentStreamEventType.AgentThinking:
                        if (!string.IsNullOrWhiteSpace(evt.Content))
                        {
                            thinkingHistory.Add(evt.Content);
                            currentStatus = evt.Content;
                        }
                        StateHasChanged();
                        break;

                    case AgentStreamEventType.ToolCallComplete:
                        var toolName = evt.Content ?? "outil";
                        currentToolCalls.Add(toolName);
                        StateHasChanged();
                        break;

                    case AgentStreamEventType.TextDelta:
                        if (evt.Content != null)
                        {
                            streamingContent += evt.Content;
                            StateHasChanged();
                        }
                        break;

                    case AgentStreamEventType.Complete:
                        break;
                }

                await ScrollToBottom();
            }

            if (!string.IsNullOrEmpty(streamingContent))
            {
                var assistantMessage = new DisplayMessage
                {
                    Content = streamingContent,
                    IsUser = false,
                    Timestamp = DateTime.UtcNow,
                    ToolNames = currentToolCalls.ToList()
                };
                displayMessages.Add(assistantMessage);

                // Add to ConversationService
                ConversationService.AddMessage(conversationId, new AgentMessage
                {
                    Content = streamingContent,
                    Sender = new MessageSender { Type = SenderType.Agent },
                    Timestamp = DateTime.UtcNow,
                    ToolCalls = currentToolCalls.Select(t => new ToolCall { Name = t }).ToList()
                });
            }
        }
        catch (Exception ex)
        {
            LogService.AddLog(Nemesis.Shared.DTOs.LogLevel.Error, "Chat", $"Erreur: {ex.Message}");
            displayMessages.Add(new DisplayMessage
            {
                Content = $"❌ Erreur: {ex.Message}",
                IsUser = false,
                Timestamp = DateTime.UtcNow
            });
        }
        finally
        {
            isLoading = false;
            streamingContent = "";
            currentStatus = "";
            currentToolCalls.Clear();
            thinkingHistory.Clear();

            // Save conversation after each exchange
            if (currentConversation != null)
            {
                await ConversationService.SaveConversation(currentConversation);
            }

            StateHasChanged();
            await ScrollToBottom();
            await RefreshSessions();
        }
    }

    private string GetToolStatusMessage(string toolName)
    {
        return toolName.ToLower() switch
        {
            "file_system" => "📂 Lecture des fichiers du projet...",
            "code_index" => "🔎 Recherche dans l'index de code...",
            "web_search" => "🌐 Recherche sur le web...",
            "patch" => "📝 Création d'un patch...",
            _ => $"🔧 Utilisation de l'outil {toolName}..."
        };
    }

    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("scrollToBottom", messagesContainer); } catch { }
    }

    private string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "Nouvelle conversation";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }

    private string FormatDate(DateTime date)
    {
        var now = DateTime.UtcNow;
        var diff = now - date;

        if (diff.TotalMinutes < 1) return "maintenant";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}min";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}j";
        return date.ToString("dd/MM");
    }

    private string FormatMessage(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";

        // Step 1: Extract code blocks BEFORE HTML encoding to preserve them
        var codeBlocks = new List<string>();
        content = System.Text.RegularExpressions.Regex.Replace(
            content,
            @"```(\w*)\r?\n([\s\S]*?)```",
            m => {
                var lang = m.Groups[1].Value;
                var code = m.Groups[2].Value.Trim();
                var langLabel = string.IsNullOrEmpty(lang) ? "CODE" : lang.ToUpper();
                // Server-side syntax highlighting (no Prism.js — avoids Blazor DOM conflicts)
                var highlightedCode = HighlightCSharp(code, lang);
                var block = $"<div class=\"code-block\"><div class=\"code-header\"><span class=\"code-lang\">{langLabel}</span><button class=\"copy-btn\" onclick=\"copyCode(this)\">Copier</button></div><pre><code>{highlightedCode}</code></pre></div>";
                var placeholder = $"%%CODEBLOCK_{codeBlocks.Count}%%";
                codeBlocks.Add(block);
                return placeholder;
            });

        // Step 2: Extract inline code before encoding
        var inlineBlocks = new List<string>();
        content = System.Text.RegularExpressions.Regex.Replace(
            content,
            @"`([^`]+)`",
            m => {
                var code = System.Web.HttpUtility.HtmlEncode(m.Groups[1].Value);
                var placeholder = $"%%INLINE_{inlineBlocks.Count}%%";
                inlineBlocks.Add($"<code class=\"inline-code\">{code}</code>");
                return placeholder;
            });

        // Step 3: HTML-encode the rest (text outside code blocks)
        content = System.Web.HttpUtility.HtmlEncode(content);

        // Step 4: Format markdown (bold, italic, headers, lists)
        content = System.Text.RegularExpressions.Regex.Replace(
            content, @"\*\*([^*]+)\*\*", "<strong>$1</strong>");
        content = System.Text.RegularExpressions.Regex.Replace(
            content, @"\*([^*]+)\*", "<em>$1</em>");
        content = System.Text.RegularExpressions.Regex.Replace(
            content, @"^### (.+)$", "<h4>$1</h4>",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        content = System.Text.RegularExpressions.Regex.Replace(
            content, @"^## (.+)$", "<h3>$1</h3>",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        content = System.Text.RegularExpressions.Regex.Replace(
            content, @"^- (.+)$", "<li>$1</li>",
            System.Text.RegularExpressions.RegexOptions.Multiline);

        // Step 5: Newlines to <br> BEFORE restoring code blocks
        content = content.Replace("\n", "<br>");

        // Step 6: Restore code blocks and inline code AFTER <br> replacement
        for (int i = 0; i < codeBlocks.Count; i++)
            content = content.Replace($"%%CODEBLOCK_{i}%%", codeBlocks[i]);
        for (int i = 0; i < inlineBlocks.Count; i++)
            content = content.Replace($"%%INLINE_{i}%%", inlineBlocks[i]);

        return content;
    }

    /// <summary>
    /// Server-side syntax highlighting for C# and diff code.
    /// Produces stable HTML that works with Blazor's DOM diffing (unlike Prism.js).
    /// </summary>
    private string HighlightCSharp(string code, string lang)
    {
        // HTML-encode first to prevent XSS
        var encoded = System.Web.HttpUtility.HtmlEncode(code);

        if (lang == "diff")
        {
            // Diff highlighting: color added/removed lines
            var lines = encoded.Split('\n');
            var sb = new System.Text.StringBuilder();
            foreach (var line in lines)
            {
                if (line.StartsWith("+") && !line.StartsWith("+++"))
                    sb.AppendLine($"<span class=\"hl-diff-add\">{line}</span>");
                else if (line.StartsWith("-") && !line.StartsWith("---"))
                    sb.AppendLine($"<span class=\"hl-diff-del\">{line}</span>");
                else if (line.StartsWith("@@"))
                    sb.AppendLine($"<span class=\"hl-diff-hunk\">{line}</span>");
                else
                    sb.AppendLine(line);
            }
            return sb.ToString().TrimEnd();
        }

        // C# / general highlighting
        var result = encoded;

        // Comments (// single line)
        result = System.Text.RegularExpressions.Regex.Replace(
            result, @"(\/\/.*)$", "<span class=\"hl-comment\">$1</span>",
            System.Text.RegularExpressions.RegexOptions.Multiline);

        // Strings (&quot;...&quot; after HtmlEncode)
        result = System.Text.RegularExpressions.Regex.Replace(
            result, @"(&quot;[^&]*?&quot;)", "<span class=\"hl-string\">$1</span>");

        // C# keywords
        var keywords = new[] {
            "using", "namespace", "class", "struct", "enum", "interface",
            "public", "private", "protected", "internal", "static", "readonly",
            "override", "virtual", "abstract", "sealed", "partial", "async", "await",
            "new", "return", "if", "else", "for", "foreach", "while", "do",
            "switch", "case", "break", "continue", "default", "throw", "try", "catch", "finally",
            "var", "void", "int", "float", "double", "bool", "string", "byte", "long", "ulong",
            "true", "false", "null", "this", "base", "typeof", "sizeof", "is", "as", "in", "out", "ref",
            "get", "set", "value", "yield", "where", "select", "from"
        };
        foreach (var kw in keywords)
        {
            result = System.Text.RegularExpressions.Regex.Replace(
                result, $@"\b({kw})\b", $"<span class=\"hl-keyword\">{kw}</span>");
        }

        // Unity/common types (after keywords to avoid double-wrapping)
        var types = new[] {
            "MonoBehaviour", "NetworkBehaviour", "GameObject", "Transform", "Vector3", "Vector2",
            "Quaternion", "Color", "Rigidbody", "Collider", "AudioSource", "AudioClip",
            "SerializeField", "Header", "Tooltip", "RequireComponent",
            "NetworkVariable", "ServerRpc", "ClientRpc", "NetworkManager",
            "Action", "Func", "Task", "List", "Dictionary", "IEnumerator", "Coroutine"
        };
        foreach (var t in types)
        {
            result = System.Text.RegularExpressions.Regex.Replace(
                result, $@"\b({t})\b", $"<span class=\"hl-type\">{t}</span>");
        }

        // Numbers
        result = System.Text.RegularExpressions.Regex.Replace(
            result, @"\b(\d+\.?\d*f?)\b", "<span class=\"hl-number\">$1</span>");

        // Preprocessor directives (#if, #endif, #region, etc.)
        result = System.Text.RegularExpressions.Regex.Replace(
            result, @"^(\s*#\w+.*)$", "<span class=\"hl-preprocessor\">$1</span>",
            System.Text.RegularExpressions.RegexOptions.Multiline);

        // Attributes [SerializeField], [Header("...")]
        result = System.Text.RegularExpressions.Regex.Replace(
            result, @"(\[[\w]+(?:\(.*?\))?\])", "<span class=\"hl-attribute\">$1</span>");

        return result;
    }
}
